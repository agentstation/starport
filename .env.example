# Starport Configuration Example
# Copy this file to .env and update with your values

# Server Configuration
STARPORT_HOST=0.0.0.0
STARPORT_PORT=8080
STARPORT_ENV=development

# Logging
STARPORT_LOG_LEVEL=info
STARPORT_LOG_FORMAT=json

# Storage Configuration
STARPORT_STORAGE=badger
# For Valkey/Redis:
# STARPORT_STORAGE=valkey
# STARPORT_VALKEY_URL=localhost:6379
# STARPORT_VALKEY_PASSWORD=
# STARPORT_VALKEY_DB=0

# API Keys (for testing)
# STARPORT_ADMIN_KEY=your-admin-key-here

# Security
STARPORT_CORS_ORIGINS=*
STARPORT_RATE_LIMIT=1000
STARPORT_RATE_LIMIT_WINDOW=1m

# Metrics
STARPORT_METRICS_ENABLED=true
STARPORT_METRICS_PORT=9090

# Development
STARPORT_DEV_MODE=true
STARPORT_PRETTY_LOGS=true