# Starport Configuration
# Copy this file to .env and update values as needed

# Server Configuration
STARPORT_SERVER_PORT=8080
STARPORT_SERVER_HOST=0.0.0.0
STARPORT_SERVER_READ_TIMEOUT=30s
STARPORT_SERVER_WRITE_TIMEOUT=30s
STARPORT_SERVER_IDLE_TIMEOUT=120s
STARPORT_SERVER_SHUTDOWN_TIMEOUT=30s
STARPORT_SERVER_ENABLE_PROFILING=false
STARPORT_SERVER_ENABLE_HEALTH_CHECK=true

# Storage Configuration
STARPORT_STORAGE_MODE=badger
STARPORT_STORAGE_BADGER_PATH=./data/starport
STARPORT_STORAGE_BADGER_SYNC_WRITES=false
STARPORT_STORAGE_BADGER_COMPRESSION=snappy
STARPORT_STORAGE_BADGER_GC_INTERVAL=5m
STARPORT_STORAGE_BADGER_GC_DISCARD_RATIO=0.5

# Valkey Configuration (for distributed deployments)
# STARPORT_STORAGE_MODE=valkey
# STARPORT_STORAGE_VALKEY_URL=valkey://localhost:6379
# STARPORT_STORAGE_VALKEY_MAX_CONNECTIONS=50
# STARPORT_STORAGE_VALKEY_CLUSTER_MODE=false
# STARPORT_STORAGE_VALKEY_PASSWORD=

# Provider Configuration
# OpenAI
STARPORT_PROVIDERS_OPENAI_BASE_URL=https://api.openai.com
STARPORT_PROVIDERS_OPENAI_TIMEOUT=30s
STARPORT_PROVIDERS_OPENAI_MAX_CONNECTIONS=100
STARPORT_PROVIDERS_OPENAI_MAX_RETRIES=3
# Set your OpenAI API key
# OPENAI_API_KEY=sk-...

# Anthropic
STARPORT_PROVIDERS_ANTHROPIC_BASE_URL=https://api.anthropic.com
STARPORT_PROVIDERS_ANTHROPIC_TIMEOUT=30s
STARPORT_PROVIDERS_ANTHROPIC_MAX_CONNECTIONS=100
STARPORT_PROVIDERS_ANTHROPIC_MAX_RETRIES=3
# Set your Anthropic API key
# ANTHROPIC_API_KEY=sk-ant-...

# Google Vertex AI Gemini Configuration
# For regional endpoint: https://{location}-aiplatform.googleapis.com
# For global endpoint: https://aiplatform.googleapis.com
STARPORT_PROVIDERS_GEMINI_BASE_URL=https://us-central1-aiplatform.googleapis.com
STARPORT_PROVIDERS_GEMINI_TIMEOUT=30s
STARPORT_PROVIDERS_GEMINI_MAX_CONNECTIONS=100
STARPORT_PROVIDERS_GEMINI_MAX_RETRIES=3
# Set your Google API key
# GOOGLE_API_KEY=...

# Groq Configuration
STARPORT_PROVIDERS_GROQ_BASE_URL=https://api.groq.com/openai/v1
STARPORT_PROVIDERS_GROQ_TIMEOUT=30s
STARPORT_PROVIDERS_GROQ_MAX_CONNECTIONS=100
STARPORT_PROVIDERS_GROQ_MAX_RETRIES=3
# Set your Groq API key
# GROQ_API_KEY=gsk_...

# Mistral AI Configuration
STARPORT_PROVIDERS_MISTRAL_BASE_URL=https://api.mistral.ai/v1
STARPORT_PROVIDERS_MISTRAL_TIMEOUT=30s
STARPORT_PROVIDERS_MISTRAL_MAX_CONNECTIONS=100
STARPORT_PROVIDERS_MISTRAL_MAX_RETRIES=3
# Set your Mistral API key
# MISTRAL_API_KEY=...

# Azure OpenAI Configuration
# Replace YOUR-RESOURCE-NAME with your actual Azure OpenAI resource name
# Format: https://{resource-name}.openai.azure.com
STARPORT_PROVIDERS_AZURE_BASE_URL=https://YOUR-RESOURCE-NAME.openai.azure.com
STARPORT_PROVIDERS_AZURE_TIMEOUT=30s
STARPORT_PROVIDERS_AZURE_MAX_CONNECTIONS=100
STARPORT_PROVIDERS_AZURE_MAX_RETRIES=3
# Set your Azure OpenAI API key
# AZURE_OPENAI_API_KEY=...

# Rate Limiting Configuration
STARPORT_RATE_LIMITING_GLOBAL_REQUESTS_PER_SECOND=10000
STARPORT_RATE_LIMITING_GLOBAL_BURST_MULTIPLIER=2.0
STARPORT_RATE_LIMITING_DEFAULT_REQUESTS_PER_MINUTE=60
STARPORT_RATE_LIMITING_DEFAULT_REQUESTS_PER_HOUR=1000
STARPORT_RATE_LIMITING_DEFAULT_TOKENS_PER_MINUTE=100000
STARPORT_RATE_LIMITING_DEFAULT_TOKENS_PER_HOUR=1000000
STARPORT_RATE_LIMITING_ENABLE_HOT_RELOAD=true
STARPORT_RATE_LIMITING_CONFIG_PATH=./config/rate_limits.yaml
STARPORT_RATE_LIMITING_RELOAD_CHECK_INTERVAL=10s

# Security Configuration
STARPORT_SECURITY_MASTER_KEY_ENV=STARPORT_MASTER_KEY
STARPORT_SECURITY_ENABLE_TLS=false
# STARPORT_SECURITY_TLS_CERT_PATH=/path/to/cert.pem
# STARPORT_SECURITY_TLS_KEY_PATH=/path/to/key.pem
STARPORT_SECURITY_ALLOWED_ORIGINS=*
STARPORT_SECURITY_ENABLE_CORS=true
STARPORT_SECURITY_ENABLE_RATE_LIMITING=true
# STARPORT_SECURITY_JWT_SECRET=your-secret-here

# Logging Configuration
STARPORT_LOGGING_LEVEL=info
STARPORT_LOGGING_FORMAT=json
STARPORT_LOGGING_OUTPUT=stdout
# STARPORT_LOGGING_FILE_PATH=/var/log/starport/starport.log
STARPORT_LOGGING_MAX_SIZE=100
STARPORT_LOGGING_MAX_BACKUPS=3
STARPORT_LOGGING_MAX_AGE=7
STARPORT_LOGGING_COMPRESS=true

# Master Key (set via environment for security)
# STARPORT_MASTER_KEY=your-master-key-here