# Starport configuration reference
# Starport reads config.env from the platform user configuration directory.
# Process environment variables override values in that file.

# Server Configuration
STARPORT_SERVER_PORT=8080
STARPORT_SERVER_HOST=127.0.0.1
STARPORT_SERVER_READ_TIMEOUT=30s
STARPORT_SERVER_WRITE_TIMEOUT=30s
STARPORT_SERVER_IDLE_TIMEOUT=120s
STARPORT_SERVER_REQUEST_TIMEOUT=60s
STARPORT_SERVER_MAX_REQUEST_SIZE=10485760
STARPORT_SERVER_MAX_HEADER_BYTES=1048576
STARPORT_SERVER_SHUTDOWN_TIMEOUT=30s
STARPORT_SERVER_ENABLE_PROFILING=false
STARPORT_SERVER_ENABLE_HEALTH_CHECK=true

# Storage Configuration
STARPORT_STORAGE_MODE=badger
# STARPORT_STORAGE_BADGER_PATH=/absolute/path/to/starport/data
STARPORT_STORAGE_BADGER_SYNC_WRITES=false
STARPORT_STORAGE_BADGER_COMPRESSION=snappy
STARPORT_STORAGE_BADGER_GC_INTERVAL=5m
STARPORT_STORAGE_BADGER_GC_DISCARD_RATIO=0.5

# Valkey Configuration (for distributed deployments)
# STARPORT_STORAGE_MODE=valkey
# STARPORT_STORAGE_VALKEY_URL=valkey://localhost:6379
# STARPORT_STORAGE_VALKEY_MAX_CONNECTIONS=50
# STARPORT_STORAGE_VALKEY_CLUSTER_MODE=false
# STARPORT_STORAGE_VALKEY_PASSWORD=

# File Storage Configuration
# File records go to the storage mode above. File bytes go to this backend.
STARPORT_FILES_BACKEND=filesystem
# STARPORT_FILES_PATH=/absolute/path/to/starport/data/files
STARPORT_FILES_MAX_UPLOAD_BYTES=536870912
STARPORT_FILES_RETENTION=720h
STARPORT_FILES_SWEEP_INTERVAL=1h
# Use an S3-compatible bucket for multiple nodes. An incomplete selection
# refuses startup rather than falling back to the filesystem.
# STARPORT_FILES_BACKEND=objectstore
# STARPORT_FILES_OBJECT_STORE_BUCKET=starport-files
# STARPORT_FILES_OBJECT_STORE_REGION=us-east-1
# STARPORT_FILES_OBJECT_STORE_ENDPOINT=
# STARPORT_FILES_OBJECT_STORE_PREFIX=
# STARPORT_FILES_OBJECT_STORE_ACCESS_KEY_ID=
# STARPORT_FILES_OBJECT_STORE_SECRET_ACCESS_KEY=

# Starmap Catalog Configuration
# Starport reads one connected Starmap runtime. The source kind below decides
# the egress, the freshness age, and the request budget. See
# docs/DEPLOYMENT-TOPOLOGIES.md for the five topologies.
# Starmap acquisition credentials are separate from Starport inference keys.
# Starmap can read OPENAI_API_KEY during local acquisition. Starport resolves
# the same conventional name independently for inference.

# The catalog source. One of public, github, starmap, file, or embedded.
STARPORT_CATALOG_SOURCE=public
# The endpoint a starmap source reads, or the file a file source reads. Those
# two kinds require it. A github source treats it as an optional API base
# override. The public and embedded kinds ignore it. A non-loopback address
# must use HTTPS.
# STARPORT_CATALOG_SOURCE_URL=https://catalog.example.com/api/v1
# The credential a starmap source presents. It never pays a provider.
# STARPORT_CATALOG_SOURCE_API_KEY=
# The repository the public and github source kinds read.
STARPORT_CATALOG_SOURCE_REPOSITORY=agentstation/starmap
# The publication channel the public and github source kinds follow.
STARPORT_CATALOG_SOURCE_CHANNEL=catalog-latest
# The workflow path that must have signed a publication. An empty value selects
# the publisher preset .github/workflows/catalog-generation.yaml.
# STARPORT_CATALOG_SOURCE_SIGNER_WORKFLOW=.github/workflows/catalog-generation.yaml
# The GitHub token a fleet shares. The token raises the hourly ceiling from 60
# requests for each egress address to 5000 requests for each token.
# STARPORT_CATALOG_SOURCE_TOKEN=
# How often the gateway asks the source for a newer publication.
STARPORT_CATALOG_SOURCE_POLL_INTERVAL=1h
# How startup treats the first source read. prefer_source starts on the
# embedded baseline and adopts the source at the first successful read.
# require_source reads the source once at open and fails startup when that read
# fails.
STARPORT_CATALOG_SOURCE_STARTUP_POLICY=prefer_source
# The served-catalog age at which this instance counts its catalog as stale. A
# negative value fails startup. The runtime grades the channel warn above
# this age and critical above five thirds of it, so 6h gives 6h and 10h.
STARPORT_CATALOG_SOURCE_MAX_AGE=6h
# The propagation hop ceiling between the publisher and this gateway.
STARPORT_CATALOG_SOURCE_MAX_HOPS=8
# Starmap provider observation. A false value stops every automatic
# observation, so the gateway opens no provider connection for the catalog.
STARPORT_CATALOG_ACQUISITION_ENABLED=true
# How often provider observation runs.
STARPORT_CATALOG_ACQUISITION_INTERVAL=4h
# The directory that holds the catalog files an operator supplies and reviews.
# Starmap reads that directory as a local source. An empty value uses no
# workspace.
# STARPORT_CATALOG_WORKSPACE_PATH=/absolute/path/to/starport/catalog
# The directory that holds the retained layer store, the instance identity
# seed, and the source discovery record. An empty value uses
# XDG_STATE_HOME/starport/catalog, and otherwise
# ~/.local/state/starport/catalog. It must differ from the workspace path.
# Never share one state directory between two instances: the seed joins the
# host name and the listen address in the instance identity, so two replicas
# that share the directory derive one identity.
# STARPORT_CATALOG_STATE_DIR=/absolute/path/to/starport/state/catalog
# The window that holds a cold fleet away from one moment at startup.
STARPORT_CATALOG_STARTUP_SPREAD=15m
# The idle ceiling on one catalog payload transfer.
STARPORT_CATALOG_TRANSFER_IDLE_TIMEOUT=2m
# The total ceiling on one catalog payload transfer.
STARPORT_CATALOG_TRANSFER_MAX_DURATION=60m
# An added cap on one refresh run. Zero adds no cap, and the two transfer
# bounds end a run that does not progress.
STARPORT_CATALOG_REFRESH_TIMEOUT=0s

# Provider inference configuration
# Starmap declares provider IDs, fields, ordered conventional names, defaults,
# authentication profiles, and endpoints. Starport checks each conventional
# name before STARPORT_<PROVIDER>_<FIELD>. Do not add a provider roster here.
#
# Examples from the current catalog:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# AZURE_OPENAI_ENDPOINT=https://resource.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# OLLAMA_BASE_URL=http://localhost:11434
#
# To read a field from a direct secret source, set the catalog-derived value
# name with a _REFERENCE suffix. Quote a reference that contains #field.
# STARPORT_OPENAI_API_KEY_REFERENCE='aws-secrets-manager:starport/openai#api-key'
# STARPORT_OPENAI_API_KEY_REFERENCE='env:TEAM_OPENAI_API_KEY'
# STARPORT_OPENAI_API_KEY_REFERENCE='file:/run/secrets/openai-api-key'
# STARPORT_OPENAI_API_KEY_REFERENCE_FALLBACK_AMBIENT=false
STARPORT_CREDENTIAL_SOURCES_REMOTE_REFRESH_INTERVAL=5m
# Resolve all catalog-declared provider credential profiles at startup. Repeat
# the same reconciliation every minute. Set 0s to disable interval refresh.
STARPORT_CREDENTIAL_SOURCES_RECONCILE_INTERVAL=1m
STARPORT_CREDENTIAL_SOURCES_RECONCILE_TIMEOUT=10s

# Rate Limiting Configuration
# The global default request window. Per-key request limits and budgets are
# set on each key through the admin API and beat these defaults.
STARPORT_RATE_LIMITING_DEFAULT_REQUESTS_PER_MINUTE=60
STARPORT_RATE_LIMITING_WINDOW_SIZE=1m

# Security Configuration
# Set this to a secret value of at least 32 bytes in production.
# STARPORT_SECURITY_MASTER_KEY=replace-with-a-secret-value
STARPORT_SECURITY_ENABLE_TLS=false
# STARPORT_SECURITY_TLS_CERT_PATH=/path/to/cert.pem
# STARPORT_SECURITY_TLS_KEY_PATH=/path/to/key.pem
# STARPORT_SECURITY_ALLOWED_ORIGINS=https://console.example.com
STARPORT_SECURITY_ENABLE_CORS=false
STARPORT_SECURITY_ENABLE_RATE_LIMITING=true
# STARPORT_SECURITY_JWT_SECRET=your-secret-here

# Logging Configuration
STARPORT_LOGGING_LEVEL=info
STARPORT_LOGGING_FORMAT=json
STARPORT_LOGGING_OUTPUT=stdout
# STARPORT_LOGGING_FILE_PATH=/var/log/starport/starport.log
STARPORT_LOGGING_MAX_SIZE=100
STARPORT_LOGGING_MAX_BACKUPS=3
STARPORT_LOGGING_MAX_AGE=7
STARPORT_LOGGING_COMPRESS=true
