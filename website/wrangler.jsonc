// The starport-site Worker serves the static export in out/ and runs no
// Worker code. `pnpm build` writes out/ before each deploy.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "starport-site",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./out",
    // An unknown path gets out/404.html with status 404.
    "not_found_handling": "404-page"
  }
}
