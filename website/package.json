{
  "name": "starport-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "node scripts/copy-assets.mjs && next dev",
    "build": "node scripts/copy-assets.mjs && next build && node scripts/build-manifest.mjs",
    "lint": "eslint && pnpm typecheck",
    "typecheck": "next typegen && fumadocs-mdx && tsc --noEmit",
    "test": "vitest run",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "16.11.4",
    "fumadocs-mdx": "15.1.1",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.11.4",
    "next": "16.3.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.23",
    "remark-parse": "11.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "vfile": "6.0.3",
    "vitest": "5.0.2",
    "wrangler": "4.147.0"
  }
}
