# Candidate fresh fleet; see docs/FLEET_INITIALIZATION.md before use.
# Copy to .env.fleet, protect it with mode 0600, and replace every placeholder.
STARPORT_DEPLOYMENT_ID=production
STARPORT_SECURITY_MASTER_KEY=replace-with-a-shared-secret-of-at-least-32-characters
STARPORT_STORAGE_VALKEY_URL=valkeys://valkey.example.com:6379/0
STARPORT_STORAGE_VALKEY_USERNAME=starport
STARPORT_STORAGE_VALKEY_PASSWORD=replace-with-valkey-password
STARPORT_STORAGE_SQL_POSTGRES_URL=postgres://starport:replace-with-password@postgres.example.com/starport?sslmode=verify-full
STARPORT_FILES_OBJECT_STORE_BUCKET=replace-with-dedicated-bucket
STARPORT_FILES_OBJECT_STORE_REGION=us-east-1
# Use the ambient AWS credential chain or set both static credential fields.
# STARPORT_FILES_OBJECT_STORE_ACCESS_KEY_ID=
# STARPORT_FILES_OBJECT_STORE_SECRET_ACCESS_KEY=
# STARPORT_FILES_OBJECT_STORE_ENDPOINT=https://objectstore.example.com
# This fleet follows GitHub publications. All replicas must use the same policy.
STARPORT_CATALOG_SOURCE=public
STARPORT_CATALOG_ACQUISITION_ENABLED=false
# Set catalog-declared provider credentials here for inference.
