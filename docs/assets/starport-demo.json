{
  "schema_version": 1,
  "scenes": ["install", "catalog", "setup", "answer", "next"],
  "readme_binding": {
    "gif": "docs/assets/first-use-v1.2.0/first-use.gif",
    "poster": "docs/assets/first-use-v1.2.0/poster.png",
    "uncut": "docs/assets/first-use-v1.2.0/first-use-uncut.gif",
    "transcript": "docs/assets/first-use-v1.2.0/TRANSCRIPT.md",
    "alt_text_required": true,
    "reduced_motion_statement_required": true
  },
  "limits": {
    "gif_max_bytes": 10485760,
    "min_width": 1280,
    "min_effective_font_at_900px": 14,
    "duration_target_seconds": 45
  },
  "invalidation": {
    "rehearsal_rule": "A rehearsal record is INVALID when `git diff --quiet <candidate.head_commit> HEAD -- <product_paths>` reports a change.",
    "release_rule": "A release record binds to the release tag assets and never invalidates by tree.",
    "product_paths": [
      "cmd/",
      "internal/",
      "pkg/",
      "console/",
      "go.mod",
      "go.sum",
      ".goreleaser.yaml",
      "scripts/build-console.sh",
      "scripts/generate-release-artifacts.sh",
      "docs/site/",
      ".env.example",
      "LICENSE",
      "README.md",
      "SECURITY.md"
    ],
    "product_path_exclusions": ["internal/console/dist/"]
  },
  "current_rehearsal": "docs/proof/readme-demo/rehearsal-2026-10-04"
}
